# ════════════════════════════════════════════════════════════════════════
# LabOS v3 — Frontend environment variables (Vite)
# Copy to `.env.local` for local dev, or set as Vercel/Netlify build-time vars.
# ════════════════════════════════════════════════════════════════════════

# ── Convex (required) ─────────────────────────────────────────────────
# Your Convex deployment URL. Get it from https://dashboard.convex.dev
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# ── Branding ──────────────────────────────────────────────────────────
VITE_APP_NAME=LabOS
VITE_APP_VERSION=1.0.0

# ── Analytics (Vercel Analytics — auto-enabled on Vercel Pro) ─────────
# PostHog is optional if you want additional analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# ── REST API (optional — legacy endpoints) ───────────────────────────
# Base URL for REST API calls (used by pages not yet migrated to Convex)
VITE_API_URL=

# ── Analytics endpoint (optional) ────────────────────────────────────
# Custom analytics endpoint URL
VITE_ANALYTICS_URL=

# ── Stripe (optional) ────────────────────────────────────────────────
# Publishable key for Payment Methods page
# Get at https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=

# ════════════════════════════════════════════════════════════════════════
# Convex Server-Side Environment Variables
# These are NOT Vite vars — set them in the Convex dashboard:
#   https://dashboard.convex.dev → your project → Settings → Environment Variables
# Or via CLI: npx convex env set VAR_NAME value
# ════════════════════════════════════════════════════════════════════════

# ── AI Providers (at least one needed for AI features) ────────────────
# ANTHROPIC_API_KEY=sk-ant-...       # Used by ai.ts, grants.ts
# DEEPSEEK_API_KEY=sk-...            # Used by ai.ts, grants.ts (fallback)

# ── Stripe (server-side) ─────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...      # Used by stripe.ts for payment processing
